# Production: Google Drive is the CMS storage.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FILE_ID=

# Admin
ADMIN_INITIAL_PASSWORD=use-a-strong-10-plus-character-password
ADMIN_SESSION_SECRET=use-a-long-random-secret
ADMIN_EMAIL=mrsadabflight@gmail.com

# Password reset email (required only for real email recovery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Control Room <no-reply@yourdomain.com>
RESET_EMAIL_TO=mrsadabflight@gmail.com
SITE_URL=https://sadab.dev

# Scheduled publishing
CRON_SECRET=

# Local development: Vite automatically uses this mode; no Google credentials are needed.
CMS_STORAGE=local
